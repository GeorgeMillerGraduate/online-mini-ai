[Unit]
Description=Jenga Mini AI (API and CPU model)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jenga
Group=jenga
WorkingDirectory=/opt/jenga-mini-ai-server
ExecStart=/usr/bin/node /opt/jenga-mini-ai-server/scripts/start.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
