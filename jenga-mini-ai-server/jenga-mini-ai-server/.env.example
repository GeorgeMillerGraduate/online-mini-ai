# Copy to .env. Keep both services on loopback behind the supplied Caddy proxy.
API_HOST=127.0.0.1
API_PORT=3001
ALLOWED_ORIGIN=https://jenga-code.com,https://www.jenga-code.com
DEV_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Set true ONLY with the supplied local reverse proxy, which overwrites X-Real-IP.
TRUST_LOCAL_PROXY=false
MODEL_PATH=models/Qwen_Qwen3-0.6B-Q4_K_M.gguf
LLAMA_PORT=8081
THREADS=4
CONTEXT_SIZE=4096
MAX_OUTPUT_TOKENS=512
REQUEST_TIMEOUT_MS=120000
RATE_LIMIT_PER_MINUTE=10
SYSTEM_PROMPT=You are Jenga Mini AI, a helpful small self-hosted assistant. Give clear, concise answers. Admit uncertainty. You cannot browse the internet, access files, or execute code.
